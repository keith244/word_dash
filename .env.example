# Django Configuration for Production (via environment variables)
# DO NOT commit sensitive values to Git!
# Use 'flyctl secrets set' to set these on Fly.io

# Generate a new SECRET_KEY with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-generated-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=your-app-name.fly.dev,www.your-app-name.fly.dev

# Database Configuration - Choose one depending on your database
# For PostgreSQL (recommended):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=word_dash
# DB_USER=postgres
# DB_PASSWORD=your-secure-password
# DB_HOST=your-db-instance.internal  # Fly.io internal hostname
# DB_PORT=5432

# For MySQL:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=word_dash
# DB_USER=root
# DB_PASSWORD=your-secure-password
# DB_HOST=your-db-instance.internal
# DB_PORT=3306

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password  # Use app-specific password for Gmail

# Environment marker
DJANGO_ENV=production
PYTHONUNBUFFERED=1
